---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();

const formatDate = (date: Date) => {
  return date.toISOString().split('T')[0];
};

const categoryIcons: Record<string, string> = {
  'security': '\u{1F6E1}',
  '3d-printing': '\u{1F4E6}',
  'electronics': '\u{26A1}',
  'python': '\u{1F40D}',
  'ai': '\u{1F916}',
  'devops': '\u{2699}',
};
---

<BaseLayout title={`${project.data.title} | ~/projects`} description={project.data.description}>
  <main class="project-detail-page">
    <!-- Header -->
    <section class="project-header">
      <div class="header-nav">
        <a href="/projects" class="back-link">
          <span class="back-arrow">&#x2190;</span>
          <span>cd ..</span>
        </a>
      </div>
      <div class="header-meta">
        <div class="meta-line">
          <span class="meta-prompt">~$</span>
          <span class="meta-command">cat</span>
          <span class="meta-file">{project.slug}/README.md</span>
        </div>
        <div class="meta-info">
          <span class="meta-category">{categoryIcons[project.data.category]} {project.data.category}</span>
          <span class="meta-date">[{formatDate(project.data.date)}]</span>
          {project.data.tags?.map((tag: string) => (
            <span class="meta-tag">#{tag}</span>
          ))}
        </div>
      </div>
      <h1 class="project-title">{project.data.title}</h1>
      <p class="project-description">{project.data.description}</p>

      <!-- Project Links -->
      <div class="project-actions">
        {project.data.github && (
          <a href={project.data.github} target="_blank" rel="noopener" class="action-link github">
            <span class="action-cmd">git clone</span>
            <span class="action-label">source code</span>
          </a>
        )}
        {project.data.demo && (
          <a href={project.data.demo} target="_blank" rel="noopener" class="action-link demo">
            <span class="action-cmd">./run</span>
            <span class="action-label">live demo</span>
          </a>
        )}
      </div>
    </section>

    <!-- Project Image -->
    {project.data.image && (
      <section class="project-image-section">
        <img src={project.data.image} alt={project.data.title} class="project-image" />
      </section>
    )}

    <!-- Content -->
    <article class="project-content">
      <Content />
    </article>

    <!-- Footer -->
    <section class="project-footer">
      <div class="footer-terminal">
        <p class="footer-line">
          <span class="footer-prompt">~$</span>
          <span class="footer-text">echo "EOF"</span>
        </p>
        <p class="footer-output">EOF</p>
      </div>
      <div class="footer-nav">
        <a href="/projects" class="nav-link">
          <span class="nav-cmd">ls -la</span>
          <span class="nav-label">all projects</span>
        </a>
        <a href="/contact" class="nav-link">
          <span class="nav-cmd">ping</span>
          <span class="nav-label">get in touch</span>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .project-detail-page {
    min-height: 100vh;
    background: #0a0a0f;
  }

  /* Header */
  .project-header {
    max-width: 800px;
    margin: 0 auto;
    padding: 6rem 1.5rem 2rem;
  }

  .header-nav {
    margin-bottom: 2rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.875rem;
    color: #666;
    text-decoration: none;
    padding: 0.5rem 1rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    transition: all 0.2s ease;
  }

  .back-link:hover {
    color: #4ecdc4;
    border-color: rgba(78, 205, 196, 0.3);
    background: rgba(78, 205, 196, 0.1);
  }

  .back-arrow {
    transition: transform 0.2s ease;
  }

  .back-link:hover .back-arrow {
    transform: translateX(-4px);
  }

  .header-meta {
    margin-bottom: 1.5rem;
  }

  .meta-line {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.875rem;
    margin-bottom: 0.75rem;
  }

  .meta-prompt {
    color: #4ecdc4;
    margin-right: 0.5rem;
  }

  .meta-command {
    color: #fff;
    margin-right: 0.5rem;
  }

  .meta-file {
    color: #667eea;
  }

  .meta-info {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
  }

  .meta-category {
    color: #667eea;
    padding: 0.125rem 0.5rem;
    background: rgba(102, 126, 234, 0.1);
    border-radius: 4px;
  }

  .meta-date {
    color: #4ecdc4;
  }

  .meta-tag {
    color: #888;
  }

  .project-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    color: #fff;
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .project-description {
    font-size: 1.125rem;
    color: #888;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  /* Action Links */
  .project-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .action-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: 0.75rem 1.5rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .action-link:hover {
    transform: translateY(-2px);
  }

  .action-link.github:hover {
    background: rgba(78, 205, 196, 0.1);
    border-color: rgba(78, 205, 196, 0.3);
  }

  .action-link.demo:hover {
    background: rgba(102, 126, 234, 0.1);
    border-color: rgba(102, 126, 234, 0.3);
  }

  .action-cmd {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.9rem;
    color: #4ecdc4;
  }

  .action-label {
    font-size: 0.7rem;
    color: #666;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Project Image */
  .project-image-section {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 1.5rem 2rem;
  }

  .project-image {
    width: 100%;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  /* Content - reuse blog post markdown styles */
  .project-content {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 1.5rem 4rem;
  }

  .project-content :global(h1),
  .project-content :global(h2),
  .project-content :global(h3),
  .project-content :global(h4) {
    color: #fff;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-weight: 600;
  }

  .project-content :global(h1) {
    font-size: 2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding-bottom: 0.5rem;
  }

  .project-content :global(h2) {
    font-size: 1.5rem;
    color: #667eea;
  }

  .project-content :global(h3) {
    font-size: 1.25rem;
    color: #4ecdc4;
  }

  .project-content :global(p) {
    color: #b0b0b0;
    line-height: 1.8;
    margin-bottom: 1.5rem;
  }

  .project-content :global(a) {
    color: #4ecdc4;
    text-decoration: none;
    border-bottom: 1px solid rgba(78, 205, 196, 0.3);
    transition: all 0.2s ease;
  }

  .project-content :global(a:hover) {
    color: #667eea;
    border-color: rgba(102, 126, 234, 0.5);
  }

  .project-content :global(strong) {
    color: #fff;
    font-weight: 600;
  }

  .project-content :global(em) {
    color: #888;
    font-style: italic;
  }

  .project-content :global(code) {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.875em;
    background: rgba(255, 255, 255, 0.05);
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
    color: #4ecdc4;
  }

  .project-content :global(pre) {
    background: #1a1a2e !important;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: 1.5rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .project-content :global(pre code) {
    background: transparent;
    padding: 0;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .project-content :global(blockquote) {
    border-left: 3px solid #667eea;
    padding-left: 1.5rem;
    margin: 1.5rem 0;
    color: #888;
    font-style: italic;
  }

  .project-content :global(ul),
  .project-content :global(ol) {
    color: #b0b0b0;
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .project-content :global(li) {
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }

  .project-content :global(hr) {
    border: none;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
    margin: 3rem 0;
  }

  .project-content :global(img) {
    max-width: 100%;
    border-radius: 12px;
    margin: 1.5rem 0;
  }

  .project-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.875rem;
  }

  .project-content :global(th) {
    text-align: left;
    padding: 0.75rem 1rem;
    background: rgba(255, 255, 255, 0.05);
    color: #667eea;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .project-content :global(td) {
    padding: 0.75rem 1rem;
    color: #b0b0b0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.03);
  }

  .project-content :global(tr:hover td) {
    background: rgba(255, 255, 255, 0.02);
  }

  /* Footer */
  .project-footer {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 1.5rem 4rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .footer-terminal {
    padding: 2rem 0;
    text-align: center;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.875rem;
  }

  .footer-line {
    color: #666;
    margin-bottom: 0.25rem;
  }

  .footer-prompt {
    color: #4ecdc4;
    margin-right: 0.5rem;
  }

  .footer-text {
    color: #888;
  }

  .footer-output {
    color: #555;
    font-style: italic;
  }

  .footer-nav {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .nav-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: 1rem 1.5rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .nav-link:hover {
    background: rgba(102, 126, 234, 0.1);
    border-color: rgba(102, 126, 234, 0.3);
    transform: translateY(-2px);
  }

  .nav-cmd {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1rem;
    color: #4ecdc4;
  }

  .nav-label {
    font-size: 0.75rem;
    color: #666;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Light mode */
  :global(html.light) .project-detail-page {
    background: #fafafa;
  }

  :global(html.light) .project-title {
    color: #111;
  }

  :global(html.light) .project-content :global(h1),
  :global(html.light) .project-content :global(h2),
  :global(html.light) .project-content :global(h3),
  :global(html.light) .project-content :global(h4) {
    color: #111;
  }

  :global(html.light) .project-content :global(h2) {
    color: #667eea;
  }

  :global(html.light) .project-content :global(p),
  :global(html.light) .project-content :global(li),
  :global(html.light) .project-content :global(td) {
    color: #444;
  }

  :global(html.light) .project-content :global(strong) {
    color: #111;
  }

  :global(html.light) .project-content :global(pre) {
    background: #f5f5f5 !important;
    border-color: #eee;
  }

  :global(html.light) .project-content :global(th) {
    background: #f0f0f0;
  }

  :global(html.light) .back-link,
  :global(html.light) .nav-link,
  :global(html.light) .action-link {
    background: #fff;
    border-color: #ddd;
  }

  :global(html.light) .meta-command {
    color: #111;
  }

  :global(html.light) .project-image {
    border-color: #eee;
  }
</style>
